server {
    if ($host = ollama.cerberusai.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name ollama.cerberusai.dev;
    return 301 https://$host$request_uri;
}

# Cache successful auth_request responses for 60s per Authorization header.
# Without this, every single chat token request triggers a fresh round-trip
# through the api-gateway pod -> postgres which adds 50-150ms TTFT.
proxy_cache_path /var/cache/nginx/ollama_auth levels=1:2 keys_zone=ollama_auth_cache:5m max_size=64m inactive=10m use_temp_path=off;

upstream ollama_backend {
    server 127.0.0.1:11434;
    server 172.83.155.131:11434;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ollama.cerberusai.dev;

    ssl_certificate /etc/letsencrypt/live/ollama.cerberusai.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ollama.cerberusai.dev/privkey.pem;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    # Per-IP rate limit. burst=20 allows brief spikes; nodelay rejects rather than queues.
    limit_req zone=api_limit burst=20 nodelay;

    # Allow large prompt bodies + keep streaming connections alive.
    client_max_body_size 16m;
    keepalive_timeout 75s;
    keepalive_requests 1000;

    location / {
        auth_request /auth;
        auth_request_set $auth_status $upstream_status;

        proxy_pass http://ollama_backend;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:11434;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;

        # Streaming-friendly: don't buffer SSE, allow long generations.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        # Allow upgrade to HTTP/1.1 chunked responses.
        proxy_set_header Connection "";
    }

    # Internal endpoint that auth_request consults. Caches per Authorization
    # header so repeated checks skip the round-trip to api-bridge.
    #
    # Hits the local k3s NGF gateway directly (skipping public DNS, TLS, and
    # the outer nginx vhost loop). The gateway's HTTPRoute matches Host
    # api-bridge.internal and routes to the api-gateway pod which serves
    # /v1/models exactly as api.cerberusai.dev would publicly.
    location = /auth {
        internal;
        proxy_pass http://10.43.63.20:80/v1/models;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host api-bridge.internal;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;

        proxy_cache ollama_auth_cache;
        proxy_cache_key $http_authorization;
        proxy_cache_valid 200 60s;
        proxy_cache_valid 401 403 30s;
        proxy_cache_use_stale error timeout updating;
        proxy_cache_bypass $cookie_nocache $arg_nocache;
        add_header X-Auth-Cache $upstream_cache_status;
    }
}
